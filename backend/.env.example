# EcoMind Environment Configuration Example

ENVIRONMENT=development

# Model Provider Credentials
GROQ_API_KEY=
GOOGLE_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Provider-Agnostic Tier Configuration (Logical Tiers)
# Tier providers: groq, gemini, ollama
SMALL_PROVIDER=groq
SMALL_MODEL=openai/gpt-oss-20b

MEDIUM_PROVIDER=groq
MEDIUM_MODEL=qwen/qwen3.8-27b

LARGE_PROVIDER=groq
LARGE_MODEL=openai/gpt-oss-120b

# Local Provider Fallback (Set to false for strict production erroring)
LOCAL_PROVIDER_FALLBACK=true

# Semantic Cache Configuration & Lifecycle Controls
CACHE_ENABLED=true
CACHE_SIMILARITY_THRESHOLD=0.90
CACHE_EMBEDDING_MODEL=all-MiniLM-L6-v2
CACHE_DB_PATH=database/semantic_cache.db
CACHE_INDEX_PATH=database/semantic_cache.index
MAX_CACHE_ENTRIES=1000
CACHE_TTL_DAYS=30
