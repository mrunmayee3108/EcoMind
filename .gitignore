# =============================================================================
# EcoMind - Root Git Ignore Configuration
# =============================================================================

# --- Environment & Secret Files (NEVER COMMIT) ---
.env
.env.local
.env.*
!.env.example
backend/.env
backend/.env.local
backend/.env.*
!backend/.env.example
frontend/.env
frontend/.env.local
frontend/.env.*
!frontend/.env.example

# --- Python & Virtual Environments ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
backend/venv/
backend/.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# --- Node.js & Frontend Builds ---
node_modules/
frontend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
frontend/dist/
frontend/dist-ssr/
frontend/.nx/

# --- SQLite Databases & Cache Indexes (Persisted via Docker Volumes) ---
*.db
*.db-journal
*.db-wal
*.db-shm
*.index
*.lock
database/*.db
database/*.index
backend/database/*.db
backend/database/*.index

# --- Testing & Coverage ---
.pytest_cache/
.coverage
htmlcov/
coverage.xml
*.cover

# --- IDE & OS Metadata ---
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.swo
.DS_Store
Thumbs.db

