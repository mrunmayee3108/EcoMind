# =============================================================================
# EcoMind Environment Configuration Template
# Copy this file to .env (or backend/.env) and populate with your credentials.
# NEVER commit .env to version control!
# =============================================================================

ENVIRONMENT=development

# --- Model Provider API Credentials ---
# Required for Groq cloud inference (Small, Medium, Large tiers by default)
GROQ_API_KEY=your_groq_api_key_here

# Optional: Required for Google Gemini models
GOOGLE_API_KEY=your_google_gemini_api_key_here

# Optional: Local Ollama URL (default: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# --- Provider-Agnostic Tier Configuration ---
SMALL_PROVIDER=groq
SMALL_MODEL=openai/gpt-oss-20b

MEDIUM_PROVIDER=groq
MEDIUM_MODEL=qwen/qwen3.8-27b

LARGE_PROVIDER=groq
LARGE_MODEL=openai/gpt-oss-120b

LOCAL_PROVIDER_FALLBACK=true

# --- Phase 5B Environmental Accounting & Cloud Estimation ---
# When true, computes peer-reviewed empirical cloud energy estimates (ML.ENERGY / EcoLogits)
# When false, physical cloud energy remains strictly UNAVAILABLE (zero fabrication)
ENABLE_CLOUD_ENERGY_ESTIMATION=true
CLOUD_ESTIMATOR_PREFERENCE=composite
LOCAL_GRID_INTENSITY_GCO2E_PER_KWH=370.0
LOCAL_GRID_REGION=US
ENABLE_DYNAMIC_GRID_INTENSITY=true

# --- Phase 4 Semantic Cache Settings ---
CACHE_ENABLED=true
CACHE_SIMILARITY_THRESHOLD=0.90
CACHE_EMBEDDING_MODEL=all-MiniLM-L6-v2
CACHE_DB_PATH=database/semantic_cache.db
CACHE_INDEX_PATH=database/semantic_cache.index
MAX_CACHE_ENTRIES=1000
CACHE_TTL_DAYS=30

# --- Phase 6 Multi-Objective Routing Optimizer Weights ---
ROUTER_WEIGHT_QUALITY=0.40
ROUTER_WEIGHT_LATENCY=0.25
ROUTER_WEIGHT_COST=0.20
ROUTER_WEIGHT_ENVIRONMENT=0.15
ROUTER_PARETO_ENABLED=true

# --- Phase 8 Historical Storage Settings ---
HISTORICAL_DB_PATH=database/historical_telemetry.db
HISTORICAL_STORE_ENABLED=true

# --- Frontend Configuration (for Docker builds) ---
# Leave empty ("") when using Nginx reverse-proxy in Docker Compose
VITE_API_BASE_URL=

